# Optional Hydra Jev overrides. By default, Jev uses OpenCode Zen's
# https://opencode.ai/zen/v1/systemone endpoint and reads the existing Zen key
# from ~/.local/share/opencode/auth.json (provider "opencode").
# Copy this file to .env only if you need an override.

# JEV_ENDPOINT=https://opencode.ai/zen/v1/systemone
# Optional token override; the saved Zen credential is used by default.
# JEV_API_TOKEN=
# Set JEV_MODEL to override the active profile's jev.model.
# JEV_MODEL=jev-1.13

# Optional path overrides for non-default OpenCode data locations:
# OPENCODE_AUTH_FILE=/path/to/opencode/auth.json
# XDG_DATA_HOME=/path/to/share
